{
  "expo": {
    "name": "MGP Analytics",
    "slug": "mgp-analytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mgp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mgpanalytics.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121317",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mgpanalytics.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121317",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#121317"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a screenshot, like a bet slip or an odds board, for the Analyst to read",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e2931e03-8ca1-450e-a95e-82cafa55c651"
      }
    },
    "owner": "jerryvix",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e2931e03-8ca1-450e-a95e-82cafa55c651"
    }
  }
}
